GROQ_API_KEY=your-key-here
GROQ_MODEL=openai/gpt-oss-120b
# low | medium | high. Reasoning tokens count against the 2000-token answer budget.
GROQ_REASONING_EFFORT=low

# Cost guard and rate limit (0 disables a limit). Defaults shown.
AGENT_RATE_PER_MIN=10
AGENT_DAILY_LIMIT=300
AGENT_MAX_BLIPS=200
AGENT_MAX_TRANSCRIPT_CHARS=40000
# @researcher reads URLs already in the thread through the fetch MCP server (.kiro/settings/mcp.json).
# Needs uvx. Set AGENT_LOOKUPS=off to disable.
AGENT_LOOKUPS=on
AGENT_MAX_FETCHES=3
AGENT_PAGE_CHARS=6000
